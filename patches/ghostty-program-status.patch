+
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) void {
+        switch (cmd) {
+            .report => |report| self.programStatusReport(report.data),
+
+            // The reply is always the same fixed bytes, ended with the
+            // terminator the query used. The specification never allows
+            // sending report contents back to the program.
+            .query => |terminator| switch (terminator) {
+                inline else => |t| self.messageWriter(.{
+                    .write_stable = "\x1b]7501;?" ++ comptime t.string(),
+                }),
+            },
+        }
+    }
+
+    /// The body points into the parser's buffer, which the next sequence
+    /// overwrites, so it is copied before it crosses to the surface.
+    fn programStatusReport(self: *StreamHandler, body: []const u8) void {
+        const req = apprt.surface.Message.WriteReq.init(self.alloc, body) catch |err| {
+            log.warn("failed to copy program status report err={}", .{err});
+            return;
+        };
+        self.surfaceMessageWriter(.{ .program_status = req });
+    }
