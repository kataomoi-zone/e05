#!/bin/sh
# Block pushes that introduce secrets, scanned with gitleaks over the
# commits being pushed. Graceful: if gitleaks is not installed the hook
# skips with a notice, so it never breaks a push for contributors who
# have not opted in — run `brew install gitleaks` to enable it. False
# positives are allowlisted in .gitleaks.toml.
# Enable hooks once per clone with:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not installed, skipping secret scan (brew install gitleaks to enable)."
  exit 0
fi

fail=0
# stdin lines: <local ref> <local oid> <remote ref> <remote oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  # Skip ref deletions (local oid all-zero): nothing to scan.
  case "$local_oid" in *[!0]*) : ;; *) continue ;; esac

  case "$remote_oid" in
    *[!0]*)
      # Updating an existing remote ref: scan just the new commits. But if
      # the remote tip is not in our local object DB (e.g. a force-push over
      # a remote we never fetched), git log cannot resolve the range and
      # gitleaks logs an error yet exits 0 — slipping the commits through
      # unscanned. Fall back to scanning every local commit not on a
      # remote-tracking ref so the scan fails closed.
      if git rev-parse --verify --quiet "${remote_oid}^{commit}" >/dev/null 2>&1; then
        range="$remote_oid..$local_oid"
      else
        range="$local_oid --not --remotes"
      fi
      ;;
    *) range="$local_oid --not --remotes" ;; # new branch: commits not yet pushed anywhere
  esac

  out=$(gitleaks detect --no-banner --redact --log-opts="$range" 2>&1)
  if [ $? -ne 0 ]; then
    fail=1
    echo
    echo "pre-push: gitleaks flagged commits being pushed ($range):"
    printf '%s\n' "$out" | grep -iE "Finding|Secret:|File:|Line|RuleID|leaks found" | head -20
  fi
done

if [ "$fail" -ne 0 ]; then
  echo
  echo "Push aborted by gitleaks. Inspect: gitleaks detect --log-opts=\"<range>\" -v"
  echo "Real secret -> remove it (history rewrite) and rotate. False positive -> allowlist in .gitleaks.toml."
  exit 1
fi
exit 0
