use flake

# Release distribution: Developer ID signing + Apple notarisation.
# Copy this file to .envrc and fill in the values for your Apple
# Developer account, then run `direnv allow`. .envrc is gitignored
# so real identifiers and key paths stay local. See
# `scripts/build_app.sh` and `scripts/notarize.sh --help` for how
# each variable is consumed.

# Identity string from `security find-identity -v -p codesigning`
# (the text inside the double quotes).
# export E05_SIGN_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"

# App Store Connect API key issued at
# https://appstoreconnect.apple.com/access/integrations/api
# .p8 can only be downloaded once; lose it and you must revoke +
# regenerate the key.
# export E05_NOTARY_KEY_ID=""
# export E05_NOTARY_ISSUER=""
# export E05_NOTARY_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
