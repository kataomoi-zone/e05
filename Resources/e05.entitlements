<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime entitlements for release builds only.
         App Sandbox is intentionally NOT enabled: e05 hosts
         libghostty terminals, WKWebView panes, .appex web extensions,
         and a native filesystem-browser pane that all need broad
         user-tier access. Each cs.* key relaxes one Hardened Runtime
         restriction; start minimal and add more only when a release
         crash log, or a device the OS refuses without a prompt,
         demands it. -->

    <!-- WebKit JIT compiles JavaScript via writable+executable pages. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- WKWebView helpers (com.apple.WebKit.WebContent etc.) and
         loaded .appex web extensions are signed with their own
         identities, not e05's. Library validation would refuse to
         load them otherwise. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The devices a page can ask for through the pane's permission
         prompt. Under the Hardened Runtime the OS refuses each of
         these without any prompt unless the signature carries its
         entitlement; the usage strings in Info.plist alone are not
         enough. A dev build signs without the runtime and so never
         notices their absence. The grant is the process's, so a
         program run in a terminal pane reaches the same devices,
         behind the OS's own prompt. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.location</key>
    <true/>
</dict>
</plist>
