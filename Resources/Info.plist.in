<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>e05</string>
    <key>CFBundleIdentifier</key>
    <string>__BUNDLE_ID__</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>__DISPLAY_NAME__</string>
    <key>CFBundleDisplayName</key>
    <string>__DISPLAY_NAME__</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__SHORT_VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD_NUMBER__</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Browser app: the user navigates to arbitrary URLs including
         intranet `http://` sites and custom-TLD developer setups like
         `*.localhost` subdomains (`http://dev.foo.localhost/`). Default
         ATS behaviour on macOS 26 admits literal `127.0.0.1` / bare
         `localhost` but not multi-level localhost subdomains, so
         without this opt-out the navigation surfaces as a bare
         `ERR_FAILED`. Same general permission Safari and
         Chromium-derived browsers grant themselves. Narrower
         alternatives don't fit: `NSExceptionDomains` would need an
         entry for every host the user might ever visit, and
         `NSAllowsLocalNetworking` still blocks public plain-HTTP
         sites (legacy blogs, archive mirrors, intranet over public
         DNS) that a general browser is expected to load. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>e05 needs camera access to satisfy permission requests from web pages.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>e05 needs microphone access to satisfy permission requests from web pages.</string>
    <key>NSLocationUsageDescription</key>
    <string>e05 needs location access to satisfy permission requests from web pages.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>e05 needs location access to satisfy permission requests from web pages.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>__BUNDLE_ID__.url</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>e05</string>
            </array>
            <key>LSHandlerRank</key>
            <string>__URL_HANDLER_RANK__</string>
        </dict>
    </array>
</dict>
</plist>
