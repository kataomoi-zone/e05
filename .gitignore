# macOS
.DS_Store
*.swp
*~

# Editor logs (e.g. nvim's :messages log written into the working tree)
nvim.log

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# libghostty pre-built binary
GhosttyKit.xcframework/

# Sparkle release fetched by scripts/fetch_sparkle.sh (SPARKLE_VERSION)
.sparkle/

# Nix
result
result-*
.direnv/
.envrc

# Environment
.env
.env.*

# .app bundle output (assembled by scripts/build_app.sh)
/build/

# Signing / notarization material (downloaded into the working tree
# during Developer ID cert setup; never commit keys or certificates)
*.cer
*.certSigningRequest
*.p8
*.p12
