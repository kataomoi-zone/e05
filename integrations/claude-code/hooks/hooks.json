{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$E05_BIN_DIR\" ] && [ -n \"$E05_PANE_ID\" ] && \"$E05_BIN_DIR/e05\" agent-hook claude \"$PPID\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$E05_BIN_DIR\" ] && [ -n \"$E05_PANE_ID\" ] && \"$E05_BIN_DIR/e05\" agent-hook claude \"$PPID\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
